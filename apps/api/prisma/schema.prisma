generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum BookingStatus {
  ENQUIRY
  PROVISIONAL
  CONFIRMED
  READY
  COMPLETE
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PAID
  VOID
}

enum DocumentType {
  CONTRACT
  INVOICE
  SONG_LIST
  UPLOAD
}

enum CommunicationStatus {
  PENDING
  SENT
  FAILED
}

// ─────────────────────────────────────────
// Models
// ─────────────────────────────────────────

model PublicProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessName       String  @default("")
  displayName        String?
  bio                String?
  email              String?
  phone              String?
  logoUrl            String?
  photo              String?
  website            String?
  socials            Json?
  clientPortalConfig Json    @default("{}")

  @@index([userId])
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addressLine1 String?
  addressLine2 String?
  city         String?
  county       String?
  postcode     String?
  country      String?
  latitude     Float?
  longitude    Float?
  placeId      String?

  bankDetails             String?
  vatNumber               String?
  vatRate                 Int     @default(20)
  defaultPaymentTermsDays Int     @default(14)
  invoiceNumberSequence   Int     @default(0)
  invoiceSequenceYear     Int     @default(0)
  depositPercentage       Int?

  digestEmailEnabled     Boolean @default(true)
  songRequestFormEnabled Boolean @default(true)

  preferences           Json      @default("{}")
  onboardingCompletedAt DateTime?
}

model Contact {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name         String
  greetingName String?
  email        String?
  phone        String?
  notes        String?
  primaryRole  String?

  // Structured address
  addressLine1 String?
  addressLine2 String?
  city         String?
  county       String?
  postcode     String?
  country      String? @default("GB")
  latitude     Float?
  longitude    Float?
  placeId      String?

  // Travel time cache (populated by background job)
  travelTimeMinutes      Int?
  travelDistanceMetres   Int?
  travelTimeCalculatedAt DateTime?
  travelMode             String?

  // Venue-specific fields
  parkingInfo        String?
  accessInfo         String?
  equipmentAvailable String?

  // Booking agent-specific fields
  website               String?
  commissionArrangement String?

  // Band roster — dep profile fields (#879/#886, ADR-0072 §4). All six are shared-with-band: a
  // dep's own attributes, meant to be visible to them once a portal projection exists (ADR-0073).
  // Organiser-private commentary belongs in `notes` above, never here. `primaryBandRole` is
  // identity ("Dave is a sax player"); `instruments` is declared capability — both feed the chair
  // picker's soft match against a chair's free-text `role`. Location reuses the existing address
  // block above; there is no separate band-specific address.
  primaryBandRole   String?
  instruments       String[] @default([])
  travelNotes       String?
  equipmentNotes    String?
  outfitNotes       String?
  availabilityNotes String?

  customerBookings     Booking[]           @relation("BookingCustomer")
  venueBookings        Booking[]           @relation("BookingVenue")
  bookingAgentBookings Booking[]           @relation("BookingAgent")
  invoices             Invoice[]
  communications       Communication[]
  series               BookingSeries[]
  bandMemberships      BookingBandMember[]

  @@index([userId])
}

model Booking {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status            BookingStatus @default(ENQUIRY)
  eventType         String
  date              DateTime
  title             String?
  fee               Decimal?      @db.Decimal(10, 2)
  notes             String?
  portalToken       String        @unique @default(uuid())
  depositReceivedAt DateTime?

  customerId String
  customer   Contact @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Restrict)

  venueId String?
  venue   Contact? @relation("BookingVenue", fields: [venueId], references: [id], onDelete: Restrict)

  bookingAgentId String?
  bookingAgent   Contact? @relation("BookingAgent", fields: [bookingAgentId], references: [id], onDelete: Restrict)

  seriesId String?
  series   BookingSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  travelMode String?
  logistics  Json?

  sets              PerformanceSet[]
  packages          Package[]
  invoices          Invoice[]
  communications    Communication[]
  documents         Document[]
  musicFormConfig   MusicFormConfig?
  musicFormResponse MusicFormResponse?
  contracts         Contract[]
  checklistItems    BookingChecklistItem[]
  invoiceLineItems  InvoiceLineItem[]
  bandChairs        BookingBandChair[]
  bandMembers       BookingBandMember[]
  lineups           Lineup[]

  @@index([userId])
  @@index([customerId])
  @@index([venueId])
  @@index([bookingAgentId])
  @@index([seriesId])
}

model BookingChecklistItem {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  key               String?
  label             String
  completedBy       String    @default("USER")
  state             String    @default("PENDING")
  order             Int
  dependsOn         String[]
  autoCompleteRule  Json?
  requiredForStatus String?
  completedAt       DateTime?
  dueDate           DateTime?
  dueDateRule       Json?
  // Per-concern reminder grouping (ADR-0052). System items resolve their concern
  // from the static concern map; custom items store a user-chosen concern here.
  // Null = a concern-less custom item that lives only on the Checklist card.
  concern           String?

  // ADR-0057: BookingChecklistItem is the GOAL. A multi-step (system) goal owns
  // its child steps; an atomic goal has none and keeps its own autoCompleteRule.
  // No column is added to this table — `steps` is a virtual relation field.
  steps BookingChecklistStep[]

  @@index([userId])
  @@index([bookingId])
}

// ADR-0057: a Step is the system-sequenced child of a multi-step Goal. v1 only
// ever creates `kind = MILESTONE` steps; the other literals exist for the model.
// State/kind/completeMode/completedBy are String fields to match the Goal's
// existing convention (no new Prisma enum — implementer's call per ADR-0057).
model BookingChecklistStep {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String

  goalId String
  goal   BookingChecklistItem @relation(fields: [goalId], references: [id], onDelete: Cascade)

  key              String?
  label            String
  order            Int
  kind             String    @default("MILESTONE") // MILESTONE | PRECONDITION | FOLLOWUP
  completeMode     String    @default("ACTION") // ACTION | AWAITED
  state            String    @default("PENDING") // PENDING | COMPLETE | FAILED
  completedBy      String    @default("USER") // USER | CUSTOMER | BAND_MEMBER
  completedAt      DateTime?
  autoCompleteRule Json?
  dueDateRule      Json?

  @@index([userId])
  @@index([bookingId])
  @@index([goalId])
}

model Contract {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  status           String    @default("DRAFT")
  content          Json
  signedAt         DateTime?
  signedFromIp     String?
  signatureDataUrl String?
  voidedAt         DateTime?

  documents Document[]

  @@index([userId])
  @@index([bookingId])
}

model PerformanceSet {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Int
  duration  Int
  startTime String?
  label     String?

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bookingId])
  @@index([packageId])
}

model PackageTemplate {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  label                 String
  category              String?
  icon                  String
  keyMoments            String[]
  defaultGenreSelection String[]
  notes                 String?
  isSystemDefault       Boolean  @default(false)
  enabled               Boolean  @default(true)

  // Band members v1 (#879, ADR-0072 §3): applying this package auto-applies its lineup, if set.
  defaultLineupTemplateId String?
  defaultLineupTemplate   LineupTemplate? @relation(fields: [defaultLineupTemplateId], references: [id], onDelete: SetNull)

  slots PackageTemplateSlot[]

  @@index([userId])
  @@index([defaultLineupTemplateId])
}

model PackageTemplateSlot {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  label    String?
  duration Int
  order    Int

  packageTemplateId String
  packageTemplate   PackageTemplate @relation(fields: [packageTemplateId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([packageTemplateId])
}

// Band members v1 (#879, ADR-0072 §3): a reusable lineup — "my five-piece". Symmetric with
// PackageTemplate → PackageTemplateSlot. Neither isSystemDefault nor enabled: a lineup is more
// personal than a package category, so a seeded "system" lineup would be deleted rather than used
// (decision taken at slicing — #883, see ADR-0072 §3).
model LineupTemplate {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  label String

  slots             LineupTemplateSlot[]
  defaultOnPackages PackageTemplate[]

  @@index([userId])
}

model LineupTemplateSlot {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role  String
  order Int

  lineupTemplateId String
  lineupTemplate   LineupTemplate @relation(fields: [lineupTemplateId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lineupTemplateId])
}

model Package {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  label String
  icon  String
  order Int

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  sets        PerformanceSet[]
  lineupLinks LineupPackage[]

  @@index([userId])
  @@index([bookingId])
}

// ADR-0081: the booking-owned instance a LineupTemplate becomes when applied — the object
// PackageTemplate -> Package already models (ADR-0046). Chairs hang off it (§3); the segments it
// plays are a many-to-many via LineupPackage (§4) — zero links is itself a segment (package-less/
// whole-day), the same rule as a null-package chair used to be, not a nullable sentinel. Retires
// `Package.lineupName`, which was this row's label with nowhere else to live.
model Lineup {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Severed-provenance snapshot of the source LineupTemplate's label (ADR-0046) — nullable because
  // a chair added one at a time (#884), with no template involved, has no label to snapshot.
  label String?

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  packages LineupPackage[]
  chairs   BookingBandChair[]

  @@index([userId])
  @@index([bookingId])
}

// The Lineup <-> Package many-to-many (ADR-0081 §4). A row means "this Lineup plays this segment";
// deleting the Package cascades the link only, never the Lineup or its chairs — the band a segment
// loses still exists, just linked to one fewer (or zero) segments.
model LineupPackage {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineupId String
  lineup   Lineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)

  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([lineupId, packageId])
  @@index([userId])
  @@index([packageId])
}

// Band members v1 (#879, ADR-0072 §2), re-pointed by ADR-0081 §3: a seat in a Lineup. `memberId` is
// nullable throughout this slice — a vacancy is `memberId = null`, a first-class thing the musician
// looks at, not an absence. `order` is per-Lineup (position within the band), not booking-wide.
model BookingBandChair {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role  String
  order Int

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  lineupId String
  lineup   Lineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)

  // #885: assignment never creates or destroys a chair row, it sets this field — filling a chair
  // sets memberId, vacating nulls it. SetNull (not Restrict/Cascade) because a member is never
  // hard-deleted (removal is soft, `removedAt`); this only guards the FK if that ever changes.
  memberId String?
  member   BookingBandMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bookingId])
  @@index([lineupId])
  @@index([memberId])
}

// Band members v1 (#879, ADR-0072 §2/§5): a person on this gig — reused across every chair the
// same contact fills, so a re-assignment is a field write on the chair, not a new roster row.
// Lifecycle: ADDED -> INVITED -> CONFIRMED | DECLINED, declared once as a coverage-guarded
// `as const satisfies` table in band-member-status.ts (CLAUDE.md's one-declaration rule) — `status`
// stays String per the #787 String-over-enum convention, exactly like BookingChecklistStep.kind.
// `ADDED -> CONFIRMED` is legal: confirming on someone's behalf must not fabricate an INVITED that
// never happened. Removal is soft — `removedAt` plus a frozen `status` — there is no REPLACED
// status; "replaced" is derived from a fresh row for the same chair, never stored.
model BookingBandMember {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  // Matches Booking.portalToken exactly (ADR-0072 §2) — the #880 portal's one-shot link.
  bandPortalToken String @unique @default(uuid())

  status String @default("ADDED")

  // An optional row for the musician themself, so a five-piece yields four vacancies, not five
  // (ADR-0072 §3) — optional because a leader may send out a band they do not play in.
  isSelf Boolean @default(false)

  sessionFee Decimal? @db.Decimal(10, 2)

  invitedAt   DateTime?
  respondedAt DateTime?
  removedAt   DateTime?

  chairs BookingBandChair[]

  @@index([userId])
  @@index([bookingId])
  @@index([contactId])
}

model BookingSeries {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  label String

  customerId String
  customer   Contact @relation(fields: [customerId], references: [id], onDelete: Restrict)

  bookings       Booking[]
  invoices       Invoice[]
  communications Communication[]

  @@index([userId])
  @@index([customerId])
}

// A partial unique index — `Invoice_seriesId_active_key`, on (seriesId) WHERE seriesId IS NOT
// NULL AND status <> 'VOID' — backs the "at most one non-VOID invoice per series" invariant.
// Prisma's schema DSL can't express a filtered unique index, so it isn't declared below as
// `@@unique`; it exists only in migrations/20260820120000_series_invoice_active_unique_index and
// in the live database. Do not add a matching `@@unique([seriesId])` here — unlike the partial
// index, an unfiltered unique constraint would apply to every row regardless of status, so it
// would forbid a VOID row from ever coexisting with the invoice that replaced it — breaking the
// invoice-number-reuse model (ADR-0028), which depends on prior VOID rows persisting. See #852.
model Invoice {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status           InvoiceStatus @default(DRAFT)
  isDeposit        Boolean       @default(false)
  invoiceNumber    String?
  issueDate        DateTime?
  dueDate          DateTime?
  // paidAt is the date the payment was *received* — chosen by the musician, defaulting to today,
  // captured in the mark-paid dialog and correctable — not the moment the button was tapped (ADR-0068).
  paidAt           DateTime?
  // Optional payment reference (e.g. a bank reference), captured alongside paidAt when known.
  paymentReference String?

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  seriesId String?
  series   BookingSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  billToContactId String
  billToContact   Contact @relation(fields: [billToContactId], references: [id], onDelete: Restrict)

  lineItems InvoiceLineItem[]
  documents Document[]

  @@index([userId])
  @@index([bookingId])
  @@index([seriesId])
}

model InvoiceLineItem {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  description String
  amount      Decimal @db.Decimal(10, 2)
  order       Int     @default(0)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  sourceBookingId String?
  sourceBooking   Booking? @relation(fields: [sourceBookingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([invoiceId])
  @@index([sourceBookingId])
}

model Template {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  content     Json
  builtInType String?

  communications Communication[]

  @@index([userId])
}

model Communication {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  direction String              @default("OUTBOUND")
  channel   String              @default("EMAIL")
  status    CommunicationStatus @default(SENT)
  subject   String
  body      String
  sentAt    DateTime?

  // Polymorphic ownership (ADR-0080, mirrors Invoice/ADR-0029): exactly one of bookingId/seriesId
  // is set, enforced at the application layer only — no DB CHECK constraint, matching Invoice.
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  seriesId String?
  series   BookingSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // null for non-invoice communications; set when an invoice PDF is attached
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bookingId])
  @@index([seriesId])
}

model Document {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type       DocumentType
  storageKey String

  // null for series invoice documents which have no direct booking association
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // null for non-INVOICE documents; set for INVOICE documents
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  // null for non-CONTRACT documents; set when a signed contract PDF is generated
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  // null for system-generated documents; required for UPLOAD type
  name String?

  communications Communication[]

  @@index([userId])
  @@index([bookingId])
  @@index([invoiceId])
  @@index([contractId])
}

model Song {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title  String
  artist String?
  genre  String
  active Boolean  @default(true)
  tags   String[]

  @@index([userId])
}

model MusicFormConfig {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enabledGenres String[]
  keyMoments    Json     @default("[]")

  // #533: draft → published. Null = draft (private to the musician); set = published (client-visible
  // on the Portal). A turned-on form is draft by default; publishing is soft and reversible.
  publishedAt DateTime?

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MusicFormResponse {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  selectedSongIds String[]
  specialRequests Json
  notes           String?
  submittedAt     DateTime @default(now())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId])
}
