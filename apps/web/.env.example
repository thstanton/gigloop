VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Identifies preprod so the UI can show a "PreProd" badge next to the wordmark
# and prefix the tab title with "[PreProd]" (src/lib/environment.ts). Local
# dev needs nothing here — it's detected automatically via Vite's DEV flag.
# Set to "preprod" on the preprod Vercel project only; leave unset on prod.
VITE_ENVIRONMENT=

# Base URL prefixed to every API request.
#
# REQUIRED, as an absolute URL, in every DEPLOYED environment — prod, preprod
# and previews alike. It is per-environment config: set it on each Vercel
# project, and make sure it is NOT marked "Sensitive", because Vercel withholds
# Sensitive plaintext from the build and bakes the var as "" (#733).
#
# Leave it unset locally: in dev/test/Storybook only, it falls back to the
# relative /api path, which the Vite dev-server proxy forwards to the local API.
# In a deployed build an empty value now THROWS rather than falling back
# (src/lib/apiBaseUrl.ts, #785). apps/web/vercel.json no longer rewrites /api to
# any host, so a relative base can no longer reach the prod API by accident —
# which is exactly how the preprod smoke-test stack could have talked to
# production (ADR-0044 §3).
VITE_API_BASE_URL=

# Example feature flag (see src/lib/featureFlags.ts for the convention).
# Default-off: unset, empty, "false", or "0" all resolve to off; "true" or
# "1" turns it on. Vite only exposes VITE_-prefixed vars to client code, so
# flag names must use that prefix.
VITE_FEATURE_EXAMPLE=

# Global command palette (ADR-0067) — quick search + quick actions behind ⌘K.
# Dark-launched: on in preprod, off in prod until go-live.
VITE_FEATURE_COMMAND_PALETTE=

# Sentry DSN for uncaught error / unhandled rejection capture (ADR-0077).
# Gates Sentry.init() in src/main.tsx — leave unset locally to capture nothing.
# Set on the preprod and prod Vercel projects only; make sure it is NOT marked
# "Sensitive", or Vercel withholds the plaintext at build time and bakes an
# empty string (the #733 trap — see VITE_API_BASE_URL above).
VITE_SENTRY_DSN=

# Band members v1 (#879, ADR-0072/0073/0074) — the lineup library, roster and
# band portal. Dark-launched: on in preprod, off in prod until go-live. Pair
# with FEATURE_BAND_MEMBERS in apps/api/.env.example.
VITE_FEATURE_BAND_MEMBERS=
